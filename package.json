{
  "name": "foundation",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "vp config",
    "build:platform": "cd apps/platform/client && bun run build && cd ../server && bun run build",
    "build:site": "cd apps/site && bun run cf-build",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "install:apps": "(cd apps/site && vp install) && (cd apps/platform && vp install)"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@types/bun": "^1.4.4",
    "cf": "^1.0.0-beta.21",
    "knip": "6",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {},
  "overrides": {
    "braces": "file:./patches/braces",
    "node-forge": "file:./patches/node-forge",
    "simple-git": "4.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {}
}
