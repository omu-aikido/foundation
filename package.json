{
  "name": "foundation",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/site",
    "apps/platform",
    "apps/platform/client",
    "apps/platform/server"
  ],
  "scripts": {
    "prepare": "vp config",
    "build:platform": "cd apps/platform/client && bun run build && cd ../server && bun run build",
    "build:site": "cd apps/site && bun run cf-build",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "cf": "1.0.0-beta.27",
    "knip": "6.44.1",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {},
  "overrides": {
    "braces": "file:./patches/braces",
    "node-forge": "file:./patches/node-forge",
    "simple-git": "4.0.2",
    "vite": "catalog:"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plus": "1.5.1"
  },
  "patchedDependencies": {}
}
