{
  "name": "official-site",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run generate-content && panda codegen && nuxt build",
    "cf-build": "bun run build && cf deploy --prebuilt --dry-run",
    "dev": "nuxt dev",
    "generate-content": "bun build/generate-site-content.ts",
    "generate-types": "cf workers types",
    "postinstall": "bun run generate-content && nuxt prepare && panda codegen",
    "preview": "wrangler dev --experimental-new-config --local --ip 127.0.0.1 --assets .output/public",
    "test": "bun test",
    "typecheck": "nuxt typecheck && bun check -p tests/tsconfig.json"
  },
  "dependencies": {
    "@nuxt/fonts": "1.2.0",
    "@nuxtjs/sitemap": "9.1.0",
    "arktype": "2.2.9",
    "design-tokens": "workspace:*",
    "h3": "2.0.8",
    "hono": "4.13.16",
    "lot-aikido": "workspace:*",
    "marked": "18.1.3",
    "nuxt": "4.6.4",
    "randori-timer": "workspace:*",
    "ts-ics": "2.4.8",
    "unplugin-icons": "24.0.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@iconify-json/ri": "1.2.10",
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.26",
    "rolldown": "1.2.16",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plugin-third-party-licenses": "workspace:*",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.14",
    "wrangler": "4.156.2"
  }
}
