{
  "name": "official-site",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run generate-content && nuxt build",
    "cf-build": "bun run build && cf deploy --prebuilt --dry-run",
    "dev": "nuxt dev",
    "generate-content": "bun build/generate-site-content.ts",
    "generate-types": "cf workers types",
    "postinstall": "bun run generate-content && nuxt prepare",
    "preview": "wrangler dev --experimental-new-config --local --ip 127.0.0.1 --assets .output/public",
    "test": "bun test",
    "typecheck": "nuxt typecheck && bun check -p tests/tsconfig.json"
  },
  "dependencies": {
    "@nuxtjs/sitemap": "^9.1.0",
    "@unocss/nuxt": "^66.12.0",
    "arktype": "^2.2.9",
    "h3": "^2.0.8",
    "hono": "^4.13.16",
    "lot-aikido": "file:../../packages/lot-aikido",
    "marked": "^18.1.2",
    "nuxt": "^4.6.3",
    "randori-timer": "file:../../packages/randori-timer",
    "ts-ics": "^2.4.8",
    "unocss": "^66.12.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@iconify-json/ri": "^1.2.10",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "cf": "^1.0.0-beta.26",
    "rolldown": "^1.2.16",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plugin-third-party-licenses": "file:../../packages/vite-plugin-third-party-licenses",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.1"
  },
  "overrides": {
    "braces": "file:../../patches/braces",
    "node-forge": "file:../../patches/node-forge",
    "simple-git": "4.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "bun@1.4.4"
}
