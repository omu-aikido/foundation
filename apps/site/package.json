{
  "name": "official-site",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run generate-content && nuxt build",
    "cf-build": "bun run generate-content && cf build",
    "dev": "nuxt dev",
    "generate-content": "bun build/generate-site-content.ts",
    "generate-types": "cf workers types",
    "postinstall": "bun run generate-content && nuxt prepare",
    "preview": "wrangler dev --experimental-new-config --local --ip 127.0.0.1 --assets .output/public",
    "test": "bun test",
    "typecheck": "nuxt typecheck && bun check -p tests/tsconfig.json"
  },
  "dependencies": {
    "@nuxtjs/sitemap": "^9.1.0",
    "@unocss/nuxt": "^66.11.0",
    "@unocss/preset-attributify": "^66.11.0",
    "arktype": "catalog:",
    "h3": "^2.0.8",
    "hono": "catalog:",
    "lot-aikido": "workspace:*",
    "marked": "^18.1.1",
    "nuxt": "^4.6.2",
    "randori-timer": "workspace:*",
    "ts-ics": "^2.4.7",
    "unocss": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@iconify-json/ri": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-third-party-licenses": "workspace:*",
    "vite-plugin-vue-devtools": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "bun"
}
